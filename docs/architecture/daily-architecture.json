      "title": "Publication boundary",
      "items": [
        "Public pages read data only through server/publication",
        "One definition of approved: approvedArticleWhere",
        "An architecture test blocks routes from importing model code"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pipeline",
      "items": [
        "Code for fixed steps; Jev for judgment; Gemini for writing and reasoning",
        "Event revision stops stale jobs from overwriting new results",
        "Quotes are matched word for word against the source in code"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and cost",
      "items": [
        "Editor review before publication; Finance always manual",
        "Ledger llm_calls: one row per call, no double payment",
        "Gateway daily cap in five tiers; over the cap, no call"
      ]
    }
